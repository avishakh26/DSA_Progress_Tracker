<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.dsatracker.controller.ProblemsController"
      spacing="16" styleClass="page-root">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="4">
            <Label text="Problems" styleClass="page-title"/>
            <Label text="Track, search, filter and solve your practice problems." styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Add Problem" onAction="#onAddProblem" styleClass="primary-button"/>
    </HBox>

    <VBox spacing="0" styleClass="card">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="Search by title..." HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="topicFilterCombo" promptText="Topic" prefWidth="150" maxWidth="150"/>
            <ComboBox fx:id="difficultyFilterCombo" promptText="Difficulty" prefWidth="130" maxWidth="130"/>
            <ComboBox fx:id="platformFilterCombo" promptText="Platform" prefWidth="130" maxWidth="130"/>
            <ComboBox fx:id="statusFilterCombo" promptText="Status" prefWidth="130" maxWidth="130"/>
            <ComboBox fx:id="sortCombo" promptText="Sort by" prefWidth="170" maxWidth="170"/>
            <Button text="Clear" onAction="#onClearFilters"/>
        </HBox>
    </VBox>

    <TableView fx:id="problemsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="titleColumn" text="Title" prefWidth="220"/>
            <TableColumn fx:id="platformColumn" text="Platform" prefWidth="110"/>
            <TableColumn fx:id="topicColumn" text="Topic" prefWidth="150"/>
            <TableColumn fx:id="difficultyColumn" text="Difficulty" prefWidth="100"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="110"/>
            <TableColumn fx:id="dateAddedColumn" text="Added" prefWidth="100"/>
            <TableColumn fx:id="dateSolvedColumn" text="Solved" prefWidth="100"/>
            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="160" sortable="false"/>
        </columns>
    </TableView>

</VBox>
